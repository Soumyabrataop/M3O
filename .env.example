# ==============================================================================
# M3O Environment Configuration File (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MongoDB Atlas Configuration (Hot-Path Telemetry)
# ------------------------------------------------------------------------------
# Replace with your actual MongoDB Atlas connection string:
# Example: mongodb+srv://myuser:mypassword@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

MONGODB_DATABASE=m3o_engine
MONGODB_COLLECTION=layer_metrics

# ------------------------------------------------------------------------------
# 2. Snowflake Data Warehouse Configuration (Cold-Path Telemetry)
# ------------------------------------------------------------------------------
# Replace with your Snowflake account identifier, user, and password:
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=M3O_ENGINE
SNOWFLAKE_SCHEMA=TELEMETRY
SNOWFLAKE_TABLE=M3O_ENGINE.TELEMETRY.LAYER_METRICS
SNOWFLAKE_ROLE=SYSADMIN

# ------------------------------------------------------------------------------
# 3. Google Gemini API (Optional for AI diagnostics)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 4. Runtime & Mock Controls
# ------------------------------------------------------------------------------
# If true, runs in local mock mode without connecting to databases
M3O_TELEMETRY_MOCK=false
M3O_SNOWFLAKE_BATCH_SIZE=50